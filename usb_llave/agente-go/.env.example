# Copia este archivo a .env y llena los valores reales. .env NUNCA se
# versiona (ver .gitignore) -- token y chat_id son secretos.

# Token del bot de Telegram de dispositivos (BotFather). Solo lo necesita
# el gateway (corre en la HP).
HERMES_DISPOSITIVOS_TOKEN=

# Tu chat_id de Telegram. Solo lo necesita el gateway.
HERMES_CHAT_ID=

# Tema privado de ntfy.sh -- que sea dificil de adivinar (es publico por
# nombre: cualquiera que sepa el tema puede publicar/leer). Lo necesitan
# tanto el agente como el gateway, deben usar el MISMO valor.
HERMES_NTFY_TOPIC=
